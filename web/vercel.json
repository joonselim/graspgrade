{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "cleanUrls": true,
  "functions": {
    "api/label.js": {
      "includeFiles": "label-media/items.json"
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|label|validate|assets/|demo|logs|try|kr).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/label-media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ko",
      "destination": "/kr",
      "permanent": false
    }
  ]
}
